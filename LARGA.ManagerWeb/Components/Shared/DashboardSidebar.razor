@* Shared across ManagerWeb's authenticated pages so the nav stays consistent as new
   pages land - trimmed to the three pages the integrative course requires. "Financial Ledger" is the
   standardized label everywhere in the app - no "Fin. Ledger" abbreviation. Collapsible
   (ToggleCollapsed) so the nav doesn't eat the whole screen at narrower widths.*@

<aside class="dashboard-sidebar @(Collapsed ? "collapsed" : "")">
    <div class="sidebar-brand">
        <div class="sidebar-logo">L</div>
        <div class="sidebar-brand-text">
            <div class="brand-name">LARGA</div>
            <div class="brand-subtext">Fleet Ops</div>
        </div>
        <button class="sidebar-toggle-btn" type="button" @onclick="ToggleCollapsed"
                title="@(Collapsed ? "Expand sidebar" : "Collapse sidebar")"
                aria-label="@(Collapsed ? "Expand sidebar" : "Collapse sidebar")">
            <span class="sidebar-toggle-icon">
                @if (Collapsed)
                {
                    <svg class="toggle-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 7 5 5-5 5"/></svg>
                }
                else
                {
                    <svg class="toggle-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 7-5 5 5 5"/></svg>
                }
            </span>
        </button>
    </div>

    <nav class="sidebar-nav">
        <a href="/dashboard" class="nav-item @(ActiveItem == "Dashboard" ? "active" : "")" title="Dashboard">
            <span class="nav-icon"><svg class="nav-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg></span>
            <span class="nav-label">Dashboard</span>
        </a>
        <a href="/driver-shifts" class="nav-item @(ActiveItem == "DriverShifts" ? "active" : "")" title="Driver &amp; Shifts">
            <span class="nav-icon"><svg class="nav-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 4.6a3.2 3.2 0 0 1 0 6.2"/><path d="M18 14.3c1.8.7 3 2.5 3 4.7"/></svg></span>
            <span class="nav-label">Driver &amp; Shifts</span>
        </a>
        <a href="/financial-ledger" class="nav-item @(ActiveItem == "FinancialLedger" ? "active" : "")" title="Financial Ledger">
            <span class="nav-icon"><svg class="nav-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18"/><path d="M16 15h2"/><path d="M6 6V5a2 2 0 0 1 2-2h8"/></svg></span>
            <span class="nav-label">Financial Ledger</span>
        </a>
    </nav>

    <div class="user-card" title="Manager">
        <div class="user-avatar">M</div>
        <div class="user-meta">
            <div class="user-name">Manager</div>
            <div class="user-role">Manager</div>
        </div>
        <button class="user-menu" type="button">•••</button>
    </div>
</aside>

@code {
    [Parameter]
    public string ActiveItem { get; set; } = string.Empty;

    private bool Collapsed { get; set; }

    private void ToggleCollapsed()
    {
        Collapsed = !Collapsed;
    }
}
